# Dockerfile.api - product API + built UI for Cloud Run (M4 spec §3.3). Built locally only; never pushed in M4.
FROM node:22-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
RUN pip install --no-cache-dir uv==0.11.*
WORKDIR /srv
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY app ./app
COPY api ./api
COPY db ./db
COPY rag ./rag
COPY ingest ./ingest
COPY --from=web /web/dist ./web/dist
RUN uv sync --frozen --no-dev
USER 65534
EXPOSE 8080
# run the built virtualenv directly: no uv (or its cache) needed at runtime, works as a non-root user
CMD ["/srv/.venv/bin/uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8080"]
